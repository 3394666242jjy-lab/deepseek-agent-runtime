# 复制为 .env，然后只填写 DEEPSEEK_API_KEY 即可。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Agent 运行参数（均可保持默认）
AGENT_DATA_DIR=.agent_data
AGENT_MAX_STEPS=8
AGENT_CONTEXT_MAX_MESSAGES=24
AGENT_CONTEXT_MAX_CHARS=24000
AGENT_REQUEST_TIMEOUT=60
AGENT_TRACE_REASONING=false
